RewriteEngine On

# ------------------------------------------------------------
# 1) Force canonical host + HTTPS (single hop)
# ------------------------------------------------------------
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.leporge-ecoledesurf\.com$ [NC]
RewriteRule ^ https://www.leporge-ecoledesurf.com%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------
# 2) Legacy WordPress URL redirects (301)
# Supports both with and without trailing slash.
# ------------------------------------------------------------
RewriteRule ^tarifs/?$ /cours [R=301,L,NC]
RewriteRule ^locations/?$ /location [R=301,L,NC]
RewriteRule ^plan-dacces/?$ /contact [R=301,L,NC]
RewriteRule ^reserver-en-ligne/?$ /reserver [R=301,L,NC]
RewriteRule ^recevoir-un-bon-cadeau-cours-de-surf/?$ /bon-cadeau [R=301,L,NC]
RewriteRule ^contact/?$ /contact [R=301,L,NC]
RewriteRule ^mentions-legales/?$ /mentions-legales [R=301,L,NC]

# Optional common aliases
RewriteRule ^index\.php$ / [R=301,L,NC]
RewriteRule ^wp-admin/?$ / [R=301,L,NC]
RewriteRule ^wp-login\.php$ / [R=301,L,NC]

# ------------------------------------------------------------
# 3) Keep real files/folders accessible (assets, images, etc.)
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Explicit public files
RewriteRule ^(robots\.txt|sitemap\.xml|favicon\.ico)$ - [L,NC]

# ------------------------------------------------------------
# 4) SPA fallback for React Router direct access
# ------------------------------------------------------------
RewriteRule ^ index.html [L]
